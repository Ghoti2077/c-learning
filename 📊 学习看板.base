filters:
  and:
    - type == "lesson"
formulas:
  lesson_label: if(lesson, "L" + lesson.toString(), "")
  status_icon: if(status == "预习", "🅿️ 预习", "✅ 已学")
  days_ago: if(date, (today() - date(date)).days, "")
properties:
  formula.lesson_label:
    displayName: 课
  title:
    displayName: 标题
  date:
    displayName: 学习日期
  formula.status_icon:
    displayName: 状态
  formula.days_ago:
    displayName: 距今天数
  tags:
    displayName: 标签
views:
  - type: table
    name: 📚 课程总表
    groupBy:
      property: status
      direction: ASC
    order:
      - formula.lesson_label
      - title
      - date
      - formula.status_icon
      - formula.days_ago
      - tags
  - type: table
    name: 🅿️ 待复习（预习中）
    filters:
      and:
        - status == "预习"
    order:
      - formula.lesson_label
      - title
      - date
      - formula.days_ago
  - type: table
    name: 🕐 最近 10 课
    groupBy:
      property: date
      direction: DESC
    order:
      - formula.lesson_label
      - title
      - date
      - formula.status_icon
    limit: 10
